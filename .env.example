# AFTERTHOUGHT — Supabase Backend Configuration
# Copy this file to .env.local to configure your cloud backend.
#
# Obtain these values from your Supabase Project Settings -> API.

# 1. Supabase Project URL (Client & Server safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Supabase Anonymous / Public API Key (Client & Server safe with Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# 3. Supabase Service Role Secret Key (OPTIONAL — SERVER-SIDE ONLY!)
# WARNING: NEVER expose this key in client-side code or commit it to version control.
# Only used by secure server API routes (such as /api/auth/delete-account).
# If omitted, account deletion will remove all user data rows, and account record removal requires dashboard action.
SUPABASE_SERVICE_ROLE_KEY=

